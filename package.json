{
  "name": "@mherzog4/yogi",
  "version": "0.1.0",
  "description": "Agent orchestration for go-to-market and distribution workflows",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sandboxes/exe": {
      "import": "./dist/sandboxes/exe.js",
      "types": "./dist/sandboxes/exe.d.ts"
    }
  },
  "bin": {
    "yogi": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "ai",
    "agents",
    "gtm",
    "marketing",
    "sandbox",
    "exe.dev"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mherzog4/Yogi"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "better-sqlite3": "^12.11.1",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
